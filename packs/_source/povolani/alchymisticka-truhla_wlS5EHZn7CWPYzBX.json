{
  "_id": "wlS5EHZn7CWPYzBX",
  "name": "Alchymistická truhla",
  "type": "feat",
  "img": "icons/skills/melee/weapons-crossed-swords-white-blue.webp",
  "folder": "QOFMpiFzGUHJdGw2",
  "sort": 1000,
  "ownership": {
    "default": 0
  },
  "effects": [],
  "system": {
    "description": {
      "value": "<p>Ze své Truhly vytáhneš za Použití truhly (počet = Úroveň alchymisty, obnova Dlouhým odpočinkem) běžný alchymistický výrobek – alchymistický oheň, dýmovnici, kyselinu, léčitelskou soupravu, léčivý lektvar, protijed, vodu sfér nebo základní jed. Akcí ho rovnou použiješ, bonusovou akcí předáš tvorovi do 2 sáhů. Od 5. Úrovně (Tvůrce mocných předmětů) jsou výrobky silnější a Krátkým odpočinkem obnovíš tolik Použití, kolik je tvá Oprava inteligence (Zlepšená improvizace).</p><p><em>Úroveň: 1.</em></p><p><em>Plné znění: <a href=\"https://dnd5esrd.d20.cz/jeskyne-a-draci/4-povolani.html#alchymista\" target=\"_blank\">SRD Jeskyní a draků – Povolání</a>.</em></p>",
      "chat": ""
    },
    "source": {
      "custom": "",
      "book": "Jeskyně a draci",
      "page": "",
      "license": "Licence JaD pro třetí strany",
      "rules": "2014"
    },
    "uses": {
      "max": "@classes.alchymista.levels",
      "spent": 0,
      "recovery": [
        {
          "period": "lr",
          "type": "recoverAll"
        },
        {
          "period": "sr",
          "type": "formula",
          "formula": "max(@abilities.int.mod, 1) * min(1, floor(@classes.alchymista.levels / 5))"
        }
      ]
    },
    "type": {
      "value": "class",
      "subtype": ""
    },
    "requirements": "Alchymista 1",
