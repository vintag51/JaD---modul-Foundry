<section class="tab jad-tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
{{#with jad}}
  {{#if chyba}}<p class="jad-nalozeni jad-stupen-pretizeni">Deník JaD se nepodařilo připravit: {{ chyba }}</p>{{else}}
  <div class="jad-povolani-radek">
    {{#each povolaniRadek}}
    <div class="jad-povolani-stitek" data-item-id="{{ id }}">
      <a class="jad-povolani-nazev" data-action="jadOtevrit" data-id="{{ id }}">{{ nazev }}{{#if obor}} <span class="jad-podpopis">({{ obor }})</span>{{/if}}</a>
      {{#if ../editovatelne}}
      <select class="level-selector" data-tooltip="Změnit úroveň – spustí postup na další úroveň">
        {{#each urovne}}<option value="{{ hodnota }}" {{#if vybrano}}selected{{/if}} {{#if zakazano}}disabled{{/if}}>{{ popis }}</option>{{/each}}
      </select>
      {{else}}<span class="jad-povolani-uroven">{{ uroven }}</span>{{/if}}
    </div>
    {{else}}
    <span class="jad-prazdne">Postava zatím nemá povolání.</span>
    {{/each}}
    {{#if editovatelne}}
    <a class="jad-tlacitko" data-action="findItem" data-item-type="class" data-tooltip="Přidat povolání z kompendia"><i class="fas fa-plus"></i> Povolání</a>
    {{/if}}
    {{#if zkusenosti}}
    <span class="jad-zkusenosti {{#if zkusenosti.postup}}jad-postup{{/if}}">
      Zkušenosti: {{ zkusenosti.value }}{{#if zkusenosti.max}} / {{ zkusenosti.max }}{{/if}}
      {{#if zkusenosti.postup}}<strong>– můžeš postoupit na další úroveň!</strong>{{/if}}
    </span>
    {{/if}}
  </div>
  <div class="jad-horni">
    <div class="jad-ctverec"><span class="jad-hodnota">{{ prof }}</span><span class="jad-popis">Zdatnostní bonus</span></div>
    <label class="jad-ctverec jad-inspirace">
      <input type="checkbox" class="jad-pole" data-cesta="system.attributes.inspiration" data-typ="bool" {{#if inspirace}}checked{{/if}} {{#unless editovatelne}}disabled{{/unless}}>
      <span class="jad-popis">Inspirace</span>
    </label>
    <div class="jad-ctverec {{ @root.rollableClass }}" data-action="roll" data-type="initiative">
      <span class="jad-hodnota">{{ iniciativa }}</span><span class="jad-popis">Iniciativa</span>
    </div>
    <div class="jad-ctverec jad-oc"><span class="jad-hodnota">{{ oc }}</span><span class="jad-popis">Obranné číslo</span></div>
    <div class="jad-ctverec jad-bv">
      <span class="jad-hodnota">
        <input type="number" class="jad-pole" data-cesta="system.attributes.hp.value" data-typ="cislo" value="{{ hp.value }}" {{#unless editovatelne}}disabled{{/unless}}>
        <span class="jad-lomitko">/</span>
        <input type="number" class="jad-pole jad-max" data-cesta="system.attributes.hp.max" data-typ="cislo-null" value="{{ hp.maxRucne }}" placeholder="{{ hp.max }}"
               data-tooltip="Maximum Bodů výdrže – prázdné = automaticky podle povolání" {{#unless editovatelne}}disabled{{/unless}}>
      </span>
      <span class="jad-popis">Body výdrže</span>
    </div>
    <div class="jad-ctverec jad-docasne">
      <span class="jad-hodnota"><input type="number" class="jad-pole" data-cesta="system.attributes.hp.temp" data-typ="cislo-null" value="{{ hp.temp }}" placeholder="—" {{#unless editovatelne}}disabled{{/unless}}></span>
      <span class="jad-popis">Dočasné BV</span>
    </div>
  </div>

  <div class="jad-sloupce">
    {{!-- Levý sloupec: vlastnosti a dovednosti --}}
    <div class="jad-sloupec jad-levy">
      <h3 class="jad-pruh">Dovednosti</h3>
      <div class="jad-vlastnosti-blok">
        <div class="jad-stity">
          {{#each vlastnosti}}
          <div class="jad-stit" data-ability="{{ key }}">
            <span class="jad-stit-nazev {{ @root.rollableClass }}" data-action="roll" data-type="ability" data-tooltip="Ověření vlastnosti">{{ nazev }}</span>
            <span class="jad-stit-oprava {{ @root.rollableClass }}" data-action="roll" data-type="ability" data-tooltip="Ověření vlastnosti">{{ oprava }}</span>
            {{#if ../upravy}}
            <input type="number" class="jad-pole jad-stit-vstup" data-cesta="system.abilities.{{ key }}.value" data-typ="cislo"
                   value="{{ zdroj }}" min="1" max="30" data-tooltip="Hodnota vlastnosti">
            {{else}}
            <span class="jad-stit-hodnota">{{ hodnota }}</span>
            {{/if}}
          </div>
          {{/each}}
        </div>
        <ul class="jad-dovednosti jad-dovednosti-vse">
          {{#each skupiny}}
          {{#if dovednosti.length}}<li class="jad-podnadpis"><span>{{ nazev }}</span></li>{{/if}}
          {{#each dovednosti}}
          <li data-key="{{ key }}">
            <a class="jad-hvezda {{ zdatnost }}" data-action="jadZdatnost" data-cesta="system.skills.{{ key }}.value" data-druh="cyklus" data-tooltip="Zdatnost (kliknutím změníš)"></a>
            <span class="jad-nazev {{ @root.rollableClass }}" data-action="roll" data-type="skill">{{ nazev }}</span>
            <span class="jad-cislo">{{ celkem }}</span>
          </li>
          {{/each}}
          {{/each}}
        </ul>
      </div>

      <h3 class="jad-pruh">Pomůcky</h3>
      <ul class="jad-dovednosti">
        {{#each pomucky}}
        <li data-key="{{ key }}">
          <a class="jad-hvezda {{ zdatnost }}" data-action="jadZdatnost" data-cesta="system.tools.{{ key }}.value" data-druh="cyklus" data-tooltip="Zdatnost (kliknutím změníš)"></a>
          <span class="jad-nazev {{ @root.rollableClass }}" data-action="roll" data-type="tool">{{ nazev }}</span>
          <span class="jad-cislo">{{ celkem }}</span>
        </li>
        {{else}}
        <li class="jad-prazdne">Žádné pomůcky</li>
        {{/each}}
      </ul>
    </div>

    {{!-- Prostřední sloupec --}}
    <div class="jad-sloupec jad-stred">
      <h3 class="jad-pruh">Zbroj</h3>
      <div class="jad-nosena-zbroj">
        <span class="jad-podpopis">Na sobě:</span>
        {{#if nosenaZbroj}}{{ nosenaZbroj }}{{else}}bez zbroje{{/if}}
        <span class="jad-oc-maly">OČ {{ oc }}</span>
      </div>
      <div class="jad-zdatnosti-zbroj">
        <span class="jad-podpopis">Zdatnost:</span>
        <a class="jad-hvezda {{#if zbroj.lehke}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.armorProf.value" data-klic="lgt" data-druh="sada"></a> Lehké
        <a class="jad-hvezda {{#if zbroj.stredni}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.armorProf.value" data-klic="med" data-druh="sada"></a> Střední
        <a class="jad-hvezda {{#if zbroj.tezke}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.armorProf.value" data-klic="hvy" data-druh="sada"></a> Těžké
        <a class="jad-hvezda {{#if zbroj.stity}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.armorProf.value" data-klic="shl" data-druh="sada"></a> Štíty
      </div>

      <div class="jad-dvojice">
        <div>
          <h3 class="jad-pruh jad-pruh-maly">Záchranné hody</h3>
          <ul class="jad-dovednosti">
            {{#each vlastnosti}}
            <li data-ability="{{ key }}">
              <a class="jad-hvezda {{#if zachranaZdatnost}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.abilities.{{ key }}.proficient" data-druh="prepinac" data-tooltip="Zdatnost v záchraně"></a>
              <span class="jad-nazev saving-throw {{ @root.rollableClass }}" data-action="roll" data-type="ability">{{ nazev }}</span>
              <span class="jad-cislo">{{ zachrana }}</span>
            </li>
            {{/each}}
          </ul>
        </div>
        <div>
          <h3 class="jad-pruh jad-pruh-maly">Pasivní dovednost</h3>
          <ul class="jad-dovednosti">
            {{#each pasivni}}
            <li><span class="jad-nazev">{{ nazev }}</span><span class="jad-cislo">{{ hodnota }}</span></li>
            {{/each}}
          </ul>
        </div>
      </div>

      {{#if kouzla.zobrazit}}
      <h3 class="jad-pruh">Kouzla / Alchymistická truhla</h3>
      <div class="jad-kouzla">
        <div class="jad-trojice">
          <div><span class="jad-cislo-velke">{{ kouzla.vlastnost }}</span><span class="jad-popis">Vlastnost</span></div>
          <div><span class="jad-cislo-velke">{{ kouzla.utok }}</span><span class="jad-popis">Út. bonus</span></div>
          <div><span class="jad-cislo-velke">{{ kouzla.so }}</span><span class="jad-popis">SO záchrany</span></div>
        </div>
        {{#if kouzla.pozice.length}}
        <div class="jad-pozice">
          {{#each kouzla.pozice}}
          <label class="jad-pozice-stupen" data-tooltip="Pozice {{ stupen }}. Stupně – zbývá">
            <span>{{ stupen }}.</span>
            <input type="number" class="jad-pole" data-cesta="{{ cesta }}" data-typ="cislo" value="{{ value }}" min="0" max="{{ max }}" {{#unless ../editovatelne}}disabled{{/unless}}>
            <span class="jad-lomitko">/ {{ max }}</span>
          </label>
          {{/each}}
        </div>
        {{/if}}
        {{#if kouzla.pakt}}
        <div class="jad-pozice">
          <label class="jad-pozice-stupen jad-pakt" data-tooltip="Magie paktu">
            <span>Pakt ({{ kouzla.pakt.stupen }}.)</span>
            <input type="number" class="jad-pole" data-cesta="system.spells.pact.value" data-typ="cislo" value="{{ kouzla.pakt.value }}" min="0" max="{{ kouzla.pakt.max }}">
            <span class="jad-lomitko">/ {{ kouzla.pakt.max }}</span>
          </label>
        </div>
        {{/if}}
        {{#if kouzla.pripravena.length}}
        <h4 class="jad-podnadpis-blok">Připravená kouzla</h4>
        <ul class="jad-seznam jad-pripravena">
          {{#each kouzla.pripravena}}
          <li data-item-id="{{ id }}">
            <span class="jad-stupen-znak" data-tooltip="Stupeň">{{ stupen }}</span>
            <a class="jad-polozka" data-action="jadPouzit" data-tooltip="Seslat"><img src="{{ img }}" alt=""><span>{{ nazev }}</span></a>
            {{#if utokSo}}<span class="jad-pouziti">{{ utokSo }}</span>{{/if}}
            <a class="jad-detail" data-action="jadOtevrit" data-tooltip="Popis kouzla"><i class="fas fa-book-open"></i></a>
          </li>
          {{/each}}
        </ul>
        {{/if}}
        {{#if kouzla.truhla}}
        <div class="jad-truhla" data-item-id="{{ kouzla.truhla.id }}">
          <a data-action="jadPouzit">Použití truhly</a>: <strong>{{ kouzla.truhla.value }} / {{ kouzla.truhla.max }}</strong>
        </div>
        {{/if}}
      </div>
      {{/if}}

      <h3 class="jad-pruh">Zbraně</h3>
      <table class="jad-tabulka jad-zbrane">
        <thead><tr><th>Zbraň / útok</th><th>Bonus</th><th>Zásah</th><th>Typ</th><th>Dosah</th></tr></thead>
        <tbody>
          {{#each zbrane}}
          <tr data-item-id="{{ id }}" class="{{#unless vybaveno}}jad-nevybaveno{{/unless}}">
            <td><div class="jad-bunka"><a class="jad-vybavit {{#if vybaveno}}aktivni{{/if}}" data-action="jadVybavit" data-tooltip="{{#if vybaveno}}V ruce / vybavená – kliknutím odložíš{{else}}Nevybavená – kliknutím vezmeš do ruky{{/if}}"><i class="fas fa-hand-fist"></i></a>
              <a class="jad-polozka" data-action="jadPouzit" data-tooltip="Zaútočit"><img src="{{ img }}" alt=""><span>{{ nazev }}</span></a></div></td>
            <td class="jad-stred-text"><strong>{{ bonus }}</strong></td><td class="jad-stred-text">{{ zasah }}</td><td>{{ typ }}</td><td>{{ dosah }}</td>
          </tr>
          {{else}}
          <tr><td colspan="5" class="jad-prazdne">Žádné zbraně</td></tr>
          {{/each}}
        </tbody>
      </table>
      <div class="jad-zdatnosti-zbroj">
        <span class="jad-podpopis">Zdatnost:</span>
        <a class="jad-hvezda {{#if zbraneZdatnost.jednoduche}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.weaponProf.value" data-klic="sim" data-druh="sada"></a> Jednoduché
        <a class="jad-hvezda {{#if zbraneZdatnost.valecne}}plna{{/if}}" data-action="jadZdatnost" data-cesta="system.traits.weaponProf.value" data-klic="mar" data-druh="sada"></a> Válečné
      </div>
    </div>

    {{!-- Pravý sloupec --}}
    <div class="jad-sloupec jad-pravy">
      <h3 class="jad-pruh">Rychlost (dle Naložení)</h3>
      <div class="jad-rychlost">
        {{#each rychlost.stupne}}
        <div class="jad-rychlost-stupen {{#if aktivni}}aktivni{{/if}}">
          <span class="jad-cislo-velke">{{ hodnota }}</span><span class="jad-popis">{{ nazev }}</span>
        </div>
        {{/each}}
      </div>
      <p class="jad-poznamka {{#if rychlost.pretizeni}}jad-varovani{{/if}}">{{ rychlost.text }}</p>

      <div class="jad-dvojice">
        <div>
          <h3 class="jad-pruh jad-pruh-maly">Kostky obnovy</h3>
          <div class="jad-stred-text"><span class="jad-cislo-velke">{{ hd.value }}</span> / {{ hd.max }}</div>
        </div>
        <div>
          <h3 class="jad-pruh jad-pruh-maly">Smrt</h3>
          <div class="jad-smrt {{ @root.rollableClass }}" data-action="roll" data-type="deathSave" data-tooltip="Záchrana proti smrti">
            <div>{{#each smrt.uspechy}}<i class="{{#if this}}fas{{else}}far{{/if}} fa-heart"></i>{{/each}}</div>
            <div>{{#each smrt.neuspechy}}<i class="fas fa-skull {{#unless this}}jad-zhasnute{{/unless}}"></i>{{/each}}</div>
          </div>
        </div>
      </div>

      <div class="jad-vycerpani">
        <span class="jad-podpopis">Vyčerpání</span>
        {{#each vycerpani.stupne}}
        <a class="jad-vycerpani-stupen {{#if plny}}plny{{/if}}" {{#if ../editovatelne}}data-action="jadVycerpani"{{/if}} data-stupen="{{ stupen }}"
           data-tooltip="{{ stupen }}. stupeň vyčerpání">{{ stupen }}</a>
        {{/each}}
      </div>

    </div>
  </div>

  <div class="jad-sloupce jad-spodek">
    <div class="jad-sloupec jad-vybava">
      <h3 class="jad-pruh">Výbava</h3>
      <div class="jad-mince">
        <span>Peníze:</span>
        {{#each mince}}
        <label><input type="number" class="jad-pole" data-cesta="{{ cesta }}" data-typ="cislo" value="{{ hodnota }}" min="0" {{#unless ../editovatelne}}disabled{{/unless}}> {{ nazev }}</label>
        {{/each}}
      </div>
      {{#if nalozeni}}
      <div class="jad-nalozeni jad-stupen-{{ nalozeni.tridaStupne }}" data-tooltip-html="{{ nalozeni.rozpis }}" data-tooltip-class="jad-tooltip" data-tooltip-direction="UP">
        <strong>{{ nalozeni.radky }} / {{ nalozeni.maximum }} Řádků</strong> – {{ nalozeni.stupen }} naložení <i class="fas fa-circle-info jad-info"></i>
        <span class="jad-meze">
          {{#if nalozeni.zjednodusena}}(zjednodušená nosnost: max. {{ nalozeni.tezke }})
          {{else}}(Lehké do {{ nalozeni.lehke }}, Střední do {{ nalozeni.stredni }}, Těžké do {{ nalozeni.tezke }}{{#unless nalozeni.batoh}} – jen s Batohem{{/unless}}){{/if}}
        </span>
      </div>
      {{/if}}
      <table class="jad-tabulka jad-radky-tabulka">
        <thead><tr><th>Předmět</th><th>Ks</th><th data-tooltip="Řádky (prázdné = automaticky)">Řádky</th><th></th></tr></thead>
        <tbody>
          {{#each vybava}}
          <tr data-item-id="{{ id }}" class="{{#if odlozeno}}jad-odlozeno{{/if}} {{#if jeKontejner}}jad-kontejner-radek{{/if}}">
            <td><div class="jad-bunka">
              <span class="jad-odsazeni" style="padding-left: {{ odsazeni }}px"></span>
              {{#if vybavitelne}}<a class="jad-vybavit {{#if vybaveno}}aktivni{{/if}}" data-action="jadVybavit" data-tooltip="{{#if vybaveno}}Vybaveno – kliknutím sundáš{{else}}Nevybaveno – kliknutím vybavíš{{/if}}"><i class="fas fa-shield-halved"></i></a>{{/if}}
              <a class="jad-polozka" data-action="jadOtevrit"><img src="{{ img }}" alt=""><span>{{ nazev }}</span></a>
            </div></td>
            <td><input type="number" class="jad-pocet" data-item-id="{{ id }}" value="{{ pocet }}" min="0" {{#unless ../editovatelne}}disabled{{/unless}}></td>
            <td><input type="text" class="jad-radky" data-item-id="{{ id }}" value="{{ rucne }}" placeholder="{{ radky }}" {{#unless ../editovatelne}}disabled{{/unless}}></td>
            <td>{{#if jeKontejner}}<a data-action="jadOdlozit" data-tooltip="{{#if vlastniOdlozeni}}Vzít zpět{{else}}Odložit i s obsahem (nepočítá se do Naložení){{/if}}"><i class="fas {{#if vlastniOdlozeni}}fa-hand{{else}}fa-arrow-down{{/if}}"></i></a>{{/if}}</td>
          </tr>
          {{else}}
          <tr><td colspan="4" class="jad-prazdne">Žádná výbava</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="jad-sloupec jad-schopnosti">
      <h3 class="jad-pruh">Schopnosti</h3>
      <p class="jad-jazyky"><strong>Jazyky:</strong> {{ jazyky }}</p>
      <ul class="jad-seznam">
        {{#each schopnosti}}
        <li data-item-id="{{ id }}">
          <a class="jad-polozka" data-action="jadPouzit"><img src="{{ img }}" alt=""><span>{{ nazev }}</span></a>
          {{#if pouziti}}<span class="jad-pouziti">{{ pouziti }}</span>{{/if}}
          <a class="jad-detail" data-action="jadOtevrit" data-tooltip="Otevřít"><i class="fas fa-book-open"></i></a>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
  {{/if}}
  <p class="jad-paticka"><img class="jad-logo" src="modules/jeskyne-a-draci/assets/logo-jad-komunitni.jpg" alt="JaD – komunitní tvorba"><br>Deník JaD – komunitní tvorba podle Licence JaD pro třetí strany.</p>
{{/with}}
</section>
